{
  "name": "homebridge-api-state-switch",
  "displayName": "Homebridge API State Switch",
  "type": "module",
  "version": "1.0.0",
  "description": "A Homebridge plugin that exposes virtual switches whose state is controlled entirely by polling an API endpoint.",
  "author": "Tom Alderson",
  "license": "Apache-2.0",
  "homepage": "https://github.com/TomAldy/homebridge-api-state-switch",
  "repository": {
    "type": "git",
    "url": "https://github.com/TomAldy/homebridge-api-state-switch.git"
  },
  "bugs": {
    "url": "https://github.com/TomAldy/homebridge-api-state-switch/issues"
  },
  "keywords": [
    "homebridge-plugin"
  ],
  "main": "dist/index.js",
  "engines": {
    "node": "^20.18.0 || ^22.10.0 || ^24.0.0",
    "homebridge": "^1.8.0 || ^2.0.0-beta.0"
  },
  "scripts": {
    "build": "rimraf ./dist && tsc",
    "lint": "eslint . --max-warnings=0",
    "prepublishOnly": "npm run lint && npm run build",
    "watch": "npm run build && npm link && nodemon",
    "test": "jest"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "homebridge-lib": "^7.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^11.0.6",
    "@semantic-release/npm": "^12.0.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.10.1",
    "eslint": "^9.39.1",
    "homebridge": "^2.0.0-beta.55",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "rimraf": "^6.1.0",
    "semantic-release": "^24.2.9",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "tag": "latest",
    "provenance": true
  }
